QUICKNODE_HTTP_URL=https://your-endpoint.quiknode.pro/YOUR_TOKEN/
QUICKNODE_WSS_URL=wss://your-endpoint.quiknode.pro/YOUR_TOKEN/

# Base58 secret key (single private key for bot wallet)
BOT_PRIVATE_KEY=replace_me

# Comma-separated list of wallet public keys to mirror
TARGET_WALLETS=WalletPubkey1,WalletPubkey2

# Jupiter v6 API
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
JUPITER_SWAP_URL=https://quote-api.jup.ag/v6/swap

# USDC mint (default quote token)
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Safety controls
MAX_SOL_PER_TRADE=0.25
MAX_OPEN_POSITIONS=5
SLIPPAGE_BPS=100
POLL_SECONDS=1.5

# AI training export (JSONL dataset)
TRAINING_EXPORT_ENABLED=true
TRAINING_EXPORT_PATH=exports/training_data.jsonl

